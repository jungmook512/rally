<?xml version="1.0"?>
<package format="3">
  <name>rally_voice</name>
  <version>0.1.0</version>
  <description>RALLY — 웨이크워드, VAD, STT, LLM 의도 추출, TTS</description>
  <maintainer email="team@rally.local">정동휘</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>rally_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>ament_index_python</depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- openwakeword · sounddevice · openai · pydantic · piper-tts 는 pip (docker/voice/requirements.txt), rosdep 키 없음 -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
