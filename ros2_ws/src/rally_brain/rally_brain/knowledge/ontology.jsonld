{
  "@context": {
    "rally": "https://rally.local/ontology#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "label": {"@id": "rdfs:label", "@language": "ko"},
    "comment": {"@id": "rdfs:comment", "@language": "ko"},
    "domain": {"@id": "rdfs:domain", "@type": "@id"},
    "range": {"@id": "rdfs:range", "@type": "@id"},
    "source": "rally:source",
    "evidence": "rally:evidence",
    "key": "rally:key",

    "trains": {"@id": "rally:trains", "@type": "@id"},
    "next": {"@id": "rally:next", "@type": "@id"},
    "usesSkill": {"@id": "rally:usesSkill", "@type": "@id"},
    "adjusts": {"@id": "rally:adjusts", "@type": "@id"},
    "difficultyParam": {"@id": "rally:difficultyParam", "@type": "@id"},
    "measures": {"@id": "rally:measures", "@type": "@id"},
    "triggers": {"@id": "rally:triggers", "@type": "@id"},
    "triggersLevel": {"@id": "rally:triggersLevel", "@type": "@id"},
    "indicatesFatigue": {"@id": "rally:indicatesFatigue", "@type": "@id"},
    "hasSession": {"@id": "rally:hasSession", "@type": "@id"},
    "hasTrial": {"@id": "rally:hasTrial", "@type": "@id"},
    "inMode": {"@id": "rally:inMode", "@type": "@id"},
    "usedParam": {"@id": "rally:usedParam", "@type": "@id"},
    "observed": {"@id": "rally:observed", "@type": "@id"},

    "modeNumber": {"@id": "rally:modeNumber", "@type": "xsd:integer"},
    "challenge": {"@id": "rally:challenge", "@type": "xsd:boolean"},
    "level": {"@id": "rally:level", "@type": "xsd:integer"},
    "threshold": {"@id": "rally:threshold", "@type": "xsd:decimal"},
    "unit": "rally:unit"
  },

  "@graph": [
    {"@id": "rally:", "@type": "owl:Ontology",
     "label": "RALLY 개념 사전",
     "comment": "근거가 있는 것만 담는다. 모든 개념·관계에 source(출처). evidence=weak 은 문서에 적혀 있지만 임상 근거가 없는 것. 추측(신체 부위 목록, 보상 동작의 뜻, 피로 강도, 보상 동작 → 대응)은 넣지 않는다 — 근거가 생기면 추가 (기획서 4.10, 2026-10-07)."},

    {"@id": "rally:Mode", "@type": "owl:Class", "label": "훈련 모드", "source": "기획서 3.1"},
    {"@id": "rally:Motion", "@type": "owl:Class", "label": "훈련 동작", "source": "기획서 3.1"},
    {"@id": "rally:Skill", "@type": "owl:Class", "label": "로봇 스킬", "comment": "rally_robot skill_server 의 action", "source": "INTERFACES 4절"},
    {"@id": "rally:Parameter", "@type": "owl:Class", "label": "스킬 파라미터", "comment": "action goal 필드. 값·범위는 skills.yaml", "source": "rally_interfaces/action"},
    {"@id": "rally:Measure", "@type": "owl:Class", "label": "판정 값", "comment": "시도 결과에서 재는 값. 계산법은 metrics.yaml", "source": "기획서 3.2~3.5 판정"},
    {"@id": "rally:Compensation", "@type": "owl:Class", "label": "보상 동작", "comment": "BodyPose.compensation_type 값", "source": "BodyPose.msg"},
    {"@id": "rally:FatigueSignal", "@type": "owl:Class", "label": "피로 신호", "source": "기획서 4.10"},
    {"@id": "rally:Cue", "@type": "owl:Class", "label": "판단 계기", "comment": "규칙 레이어가 행동을 고르는 근거가 되는 관찰", "source": "기획서 4.7"},
    {"@id": "rally:Action", "@type": "owl:Class", "label": "규칙 행동", "comment": "key = skills.yaml brain.actions 의 이름", "source": "기획서 4.7, skills.yaml brain"},
    {"@id": "rally:SafetyTrigger", "@type": "owl:Class", "label": "안전 계기", "comment": "key = SafetyStatus.reason 값", "source": "기획서 3.6, SafetyStatus.msg"},
    {"@id": "rally:SafetyLevel", "@type": "owl:Class", "label": "안전 단계", "source": "SafetyStatus.msg"},
    {"@id": "rally:Patient", "@type": "owl:Class", "label": "환자", "comment": "익명 ID 만", "source": "기획서 4.10 Knowledge Graph"},
    {"@id": "rally:Session", "@type": "owl:Class", "label": "세션", "source": "기획서 4.10 Knowledge Graph"},
    {"@id": "rally:Trial", "@type": "owl:Class", "label": "시도", "source": "기획서 4.10 Knowledge Graph"},

    {"@id": "rally:trains", "@type": "owl:ObjectProperty", "label": "훈련한다", "domain": "rally:Mode", "range": "rally:Motion", "source": "기획서 3.1~3.5"},
    {"@id": "rally:next", "@type": "owl:ObjectProperty", "label": "다음 모드", "domain": "rally:Mode", "range": "rally:Mode", "source": "기획서 3.1"},
    {"@id": "rally:usesSkill", "@type": "owl:ObjectProperty", "label": "사용한다", "domain": "rally:Mode", "range": "rally:Skill", "source": "기획서 3.2~3.5 로봇 기능, 5.2"},
    {"@id": "rally:adjusts", "@type": "owl:ObjectProperty", "label": "조절한다", "domain": "rally:Skill", "range": "rally:Parameter", "source": "rally_interfaces/action"},
    {"@id": "rally:difficultyParam", "@type": "owl:ObjectProperty", "label": "난이도 값", "domain": "rally:Mode", "range": "rally:Parameter", "source": "기획서 3.2, 3.3, 3.5, 5.2"},
    {"@id": "rally:measures", "@type": "owl:ObjectProperty", "label": "판정한다", "domain": "rally:Mode", "range": "rally:Measure", "source": "기획서 3.2~3.5 판정"},
    {"@id": "rally:triggers", "@type": "owl:ObjectProperty", "label": "일으킨다", "domain": "rally:Cue", "range": "rally:Action", "source": "기획서 4.7"},
    {"@id": "rally:triggersLevel", "@type": "owl:ObjectProperty", "label": "안전 단계로", "domain": "rally:SafetyTrigger", "range": "rally:SafetyLevel", "source": "기획서 3.6"},
    {"@id": "rally:indicatesFatigue", "@type": "owl:ObjectProperty", "label": "피로를 나타낸다", "domain": "rally:Compensation", "range": "rally:FatigueSignal",
     "source": "기획서 4.10", "evidence": "weak", "comment": "기획서에 '보상 동작 → 피로 신호'로 적혀 있으나 임상 근거는 확인 전"},
    {"@id": "rally:hasSession", "@type": "owl:ObjectProperty", "label": "세션", "domain": "rally:Patient", "range": "rally:Session", "source": "기획서 4.10"},
    {"@id": "rally:hasTrial", "@type": "owl:ObjectProperty", "label": "시도", "domain": "rally:Session", "range": "rally:Trial", "source": "기획서 4.10"},
    {"@id": "rally:inMode", "@type": "owl:ObjectProperty", "label": "모드", "domain": "rally:Trial", "range": "rally:Mode", "source": "기획서 4.10"},
    {"@id": "rally:usedParam", "@type": "owl:ObjectProperty", "label": "사용한 파라미터", "domain": "rally:Trial", "range": "rally:Parameter", "source": "기획서 4.10"},
    {"@id": "rally:observed", "@type": "owl:ObjectProperty", "label": "관찰된 보상 동작", "domain": "rally:Trial", "range": "rally:Compensation", "source": "기획서 4.10"},

    {"@id": "rally:reach", "@type": "rally:Motion", "label": "팔 뻗기", "source": "기획서 3.2"},
    {"@id": "rally:throw", "@type": "rally:Motion", "label": "던지기·협응", "source": "기획서 3.3"},
    {"@id": "rally:wrist_grasp", "@type": "rally:Motion", "label": "손목 회전·쥐기", "source": "기획서 3.4"},
    {"@id": "rally:isometric_push", "@type": "rally:Motion", "label": "등척성 밀기", "comment": "근력 훈련", "source": "기획서 3.5"},

    {"@id": "rally:mode1", "@type": "rally:Mode", "modeNumber": 1, "label": "공 굴리기", "source": "기획서 3.2",
     "trains": "rally:reach", "next": "rally:mode3",
     "usesSkill": ["rally:pick_compliant", "rally:push_ball"],
     "difficultyParam": "rally:target",
     "measures": ["rally:stop_error", "rally:patient_grasped"]},
    {"@id": "rally:mode3", "@type": "rally:Mode", "modeNumber": 3, "label": "캐치볼", "challenge": true, "source": "기획서 3.3",
     "trains": "rally:throw", "next": "rally:mode5",
     "usesSkill": ["rally:catch_ball", "rally:detach_ball", "rally:handover"],
     "difficultyParam": "rally:catch_radius",
     "measures": ["rally:caught", "rally:prediction_error", "rally:reaction_time"]},
    {"@id": "rally:mode5", "@type": "rally:Mode", "modeNumber": 5, "label": "건네고 받기", "source": "기획서 3.4, 5.2",
     "trains": "rally:wrist_grasp", "next": "rally:mode7",
     "usesSkill": ["rally:pick_compliant", "rally:handover"],
     "difficultyParam": "rally:tilt_deg",
     "measures": ["rally:wrist_angle_at_grasp", "rally:handover_time"]},
    {"@id": "rally:mode7", "@type": "rally:Mode", "modeNumber": 7, "label": "팔씨름", "source": "기획서 3.5",
     "trains": "rally:isometric_push",
     "usesSkill": "rally:resist_push",
     "difficultyParam": ["rally:stiffness", "rally:target_force_n"],
     "measures": ["rally:peak_force", "rally:hold_time", "rally:force_smoothness"]},

    {"@id": "rally:pick_compliant", "@type": "rally:Skill", "key": "/rally/skill/pick_compliant", "label": "순응 집기", "source": "INTERFACES 4절"},
    {"@id": "rally:push_ball", "@type": "rally:Skill", "key": "/rally/skill/push_ball", "label": "공 밀기", "source": "INTERFACES 4절, PushBall.action",
     "adjusts": ["rally:target", "rally:push_speed", "rally:lane"]},
    {"@id": "rally:catch_ball", "@type": "rally:Skill", "key": "/rally/skill/catch_ball", "label": "공 받기", "source": "INTERFACES 4절, CatchBall.action",
     "adjusts": ["rally:catch_radius", "rally:lead_time_s"]},
    {"@id": "rally:detach_ball", "@type": "rally:Skill", "key": "/rally/skill/detach_ball", "label": "공 떼어내기", "source": "INTERFACES 4절"},
    {"@id": "rally:handover", "@type": "rally:Skill", "key": "/rally/skill/handover", "label": "건네기·받기", "source": "INTERFACES 4절, Handover.action",
     "adjusts": ["rally:tilt_deg", "rally:release_force_threshold_n"]},
    {"@id": "rally:resist_push", "@type": "rally:Skill", "key": "/rally/skill/resist_push", "label": "저항 밀기", "source": "INTERFACES 4절, ResistPush.action",
     "adjusts": ["rally:stiffness", "rally:target_force_n"]},

    {"@id": "rally:target", "@type": "rally:Parameter", "key": "target", "label": "목표 정지 위치", "unit": "m", "source": "PushBall.action"},
    {"@id": "rally:push_speed", "@type": "rally:Parameter", "key": "push_speed", "label": "밀기 속도", "unit": "m/s", "source": "PushBall.action"},
    {"@id": "rally:lane", "@type": "rally:Parameter", "key": "lane", "label": "가이드 길", "source": "PushBall.action"},
    {"@id": "rally:catch_radius", "@type": "rally:Parameter", "key": "catch_radius", "label": "받으러 가는 반경", "unit": "m", "source": "CatchBall.action"},
    {"@id": "rally:lead_time_s", "@type": "rally:Parameter", "key": "lead_time_s", "label": "예측 선행 시간", "unit": "s", "source": "CatchBall.action"},
    {"@id": "rally:tilt_deg", "@type": "rally:Parameter", "key": "tilt_deg", "label": "제시 기울기", "unit": "deg", "source": "Handover.action"},
    {"@id": "rally:release_force_threshold_n", "@type": "rally:Parameter", "key": "release_force_threshold_n", "label": "당김 감지 힘", "unit": "N", "source": "Handover.action"},
    {"@id": "rally:stiffness", "@type": "rally:Parameter", "key": "stiffness", "label": "버티는 강성", "unit": "N/m", "source": "ResistPush.action"},
    {"@id": "rally:target_force_n", "@type": "rally:Parameter", "key": "target_force_n", "label": "목표 힘", "unit": "N", "source": "ResistPush.action"},

    {"@id": "rally:stop_error", "@type": "rally:Measure", "key": "error_mm", "label": "정지 위치 오차", "unit": "mm", "source": "기획서 3.2 판정"},
    {"@id": "rally:patient_grasped", "@type": "rally:Measure", "label": "환자가 잡았는지", "source": "기획서 3.2 판정"},
    {"@id": "rally:caught", "@type": "rally:Measure", "key": "caught", "label": "받았는지", "source": "기획서 3.3 판정, CatchBall.action"},
    {"@id": "rally:prediction_error", "@type": "rally:Measure", "key": "prediction_error_mm", "label": "착지 예측 오차", "unit": "mm", "source": "기획서 3.3, CatchBall.action"},
    {"@id": "rally:reaction_time", "@type": "rally:Measure", "key": "reaction_time_s", "label": "반응 시간", "unit": "s", "source": "기획서 3.3, CatchBall.action"},
    {"@id": "rally:wrist_angle_at_grasp", "@type": "rally:Measure", "key": "wrist_angle_at_grasp_deg", "label": "잡을 때 손목 각도", "unit": "deg", "source": "기획서 3.4 판정, Handover.action"},
    {"@id": "rally:handover_time", "@type": "rally:Measure", "key": "handover_time_s", "label": "건네받는 시간", "unit": "s", "source": "기획서 3.4 판정, Handover.action"},
    {"@id": "rally:peak_force", "@type": "rally:Measure", "key": "peak_force_n", "label": "최대 힘", "unit": "N", "source": "기획서 3.5 측정, ResistPush.action"},
    {"@id": "rally:hold_time", "@type": "rally:Measure", "key": "hold_time_achieved_s", "label": "버틴 시간", "unit": "s", "source": "기획서 3.5 측정, ResistPush.action"},
    {"@id": "rally:force_smoothness", "@type": "rally:Measure", "key": "force_smoothness", "label": "힘 떨림", "source": "기획서 3.5 측정, ResistPush.action"},

    {"@id": "rally:trunk_lean", "@type": "rally:Compensation", "key": "trunk_lean", "label": "몸통 기울이기", "threshold": 15.0, "unit": "deg",
     "source": "BodyPose.msg, FR-05(임계 15°)", "indicatesFatigue": "rally:fatigue"},
    {"@id": "rally:shoulder_hike", "@type": "rally:Compensation", "key": "shoulder_hike", "label": "어깨 들기", "source": "BodyPose.msg",
     "indicatesFatigue": "rally:fatigue"},
    {"@id": "rally:fatigue", "@type": "rally:FatigueSignal", "label": "피로", "source": "기획서 4.10"},

    {"@id": "rally:act_continue", "@type": "rally:Action", "key": "continue", "label": "계속", "source": "skills.yaml brain.actions"},
    {"@id": "rally:act_harder", "@type": "rally:Action", "key": "harder", "label": "어렵게", "source": "기획서 4.7"},
    {"@id": "rally:act_easier", "@type": "rally:Action", "key": "easier", "label": "쉽게", "source": "기획서 3.5(목표 하향)"},
    {"@id": "rally:act_suggest_rest", "@type": "rally:Action", "key": "suggest_rest", "label": "휴식 제안", "source": "기획서 3.5, 5.1"},
    {"@id": "rally:act_wait", "@type": "rally:Action", "key": "wait", "label": "대기", "source": "skills.yaml brain.actions"},
    {"@id": "rally:act_ask_llm", "@type": "rally:Action", "key": "ask_llm", "label": "LLM 판단", "source": "기획서 4.7(애매하면 LLM)"},

    {"@id": "rally:cue_voice_tired", "@type": "rally:Cue", "key": "tired", "label": "\"힘들어\" 음성", "triggers": "rally:act_suggest_rest", "source": "기획서 3.5 음성, VoiceIntent.msg"},
    {"@id": "rally:cue_voice_harder", "@type": "rally:Cue", "key": "harder", "label": "\"어렵게\" 음성", "triggers": "rally:act_harder", "source": "VoiceIntent.msg"},
    {"@id": "rally:cue_voice_easier", "@type": "rally:Cue", "key": "easier", "label": "\"쉽게\" 음성", "triggers": "rally:act_easier", "source": "VoiceIntent.msg"},
    {"@id": "rally:cue_success_streak", "@type": "rally:Cue", "key": "success_streak", "label": "연속 성공", "triggers": "rally:act_harder", "source": "기획서 4.7, 3.5"},
    {"@id": "rally:cue_failure_streak", "@type": "rally:Cue", "key": "failure_streak", "label": "연속 실패", "triggers": "rally:act_easier", "source": "todo Day 4(모드 7 실패 2회 → -10 %)"},
    {"@id": "rally:cue_safety_stop", "@type": "rally:Cue", "key": "safety_stop", "label": "안전 정지", "triggers": "rally:act_wait", "source": "기획서 5.3, NFR-08"},

    {"@id": "rally:level_normal", "@type": "rally:SafetyLevel", "level": 0, "key": "normal", "label": "정상", "source": "SafetyStatus.msg"},
    {"@id": "rally:level_slow", "@type": "rally:SafetyLevel", "level": 1, "key": "slow", "label": "느리게", "source": "SafetyStatus.msg"},
    {"@id": "rally:level_stop", "@type": "rally:SafetyLevel", "level": 2, "key": "stop", "label": "정지", "source": "SafetyStatus.msg"},

    {"@id": "rally:safe_hand_near", "@type": "rally:SafetyTrigger", "key": "hand_near_centerline", "label": "손이 중앙선 가까이(0.25 m)", "threshold": 0.25, "unit": "m",
     "triggersLevel": "rally:level_slow", "source": "기획서 3.6"},
    {"@id": "rally:safe_hand_close", "@type": "rally:SafetyTrigger", "key": "hand_near_centerline", "label": "손이 중앙선 아주 가까이(0.15 m)", "threshold": 0.15, "unit": "m",
     "triggersLevel": "rally:level_stop", "source": "기획서 3.6"},
    {"@id": "rally:safe_voice_stop", "@type": "rally:SafetyTrigger", "key": "voice_stop", "label": "\"그만\" 음성", "triggersLevel": "rally:level_stop", "source": "기획서 3.6, 4.8"},
    {"@id": "rally:safe_nudge", "@type": "rally:SafetyTrigger", "key": "nudge", "label": "로봇 툭 치기", "triggersLevel": "rally:level_stop", "source": "기획서 3.6"},
    {"@id": "rally:safe_force_limit", "@type": "rally:SafetyTrigger", "key": "force_limit", "label": "힘 한계(25 N)", "threshold": 25.0, "unit": "N",
     "triggersLevel": "rally:level_stop", "source": "기획서 3.6"},
    {"@id": "rally:safe_workspace", "@type": "rally:SafetyTrigger", "key": "workspace_limit", "label": "작업 공간 밖", "triggersLevel": "rally:level_stop", "source": "기획서 3.6"}
  ]
}
