# [Phase 2] 모드 3 후기 단계: 벨크로 패드를 들고 궤적을 그리며 이동 (환자가 맞혀야 함). Phase 1은 CatchBall 사용.
uint8 PATTERN_HOLD=0
uint8 PATTERN_LINE=1
uint8 PATTERN_CIRCLE=2
uint8 PATTERN_FIGURE8=3
uint8 PATTERN_WAYPOINTS=4

uint8 pattern
float32 speed                         # [m/s]
float32 scale                         # 궤적 크기 [m]
float32 duration_s                    # 0 = 취소될 때까지
geometry_msgs/Pose[] waypoints        # PATTERN_WAYPOINTS용
---
bool completed
uint16 impacts_detected               # 힘 피크 카운트 (보조 판정)
---
geometry_msgs/PoseStamped current_pose
float32 elapsed_s
float32 last_impact_force
