# 모드 5: 물체 건네기(GIVE) / 받기(RECEIVE)
uint8 DIR_GIVE=0
uint8 DIR_RECEIVE=1

uint8 direction
string object_class                   # rod | cup | velcro_ball | ball
float32 tilt_deg                      # 제시 각도 (손목 회전 훈련)
bool follow_hand                      # RECEIVE 시 손 추종(servol) 여부
float32 release_force_threshold_n     # GIVE: 환자가 당기는 힘 감지 임계값
float32 timeout_s
---
bool success
float32 wrist_angle_at_grasp_deg      # 환자 손목 각도 (HandState에서)
float32 handover_time_s
string failure_reason
---
string phase                          # present | wait | follow | release | grasp | retreat
float32 tool_force_n
float32 hand_distance_m
