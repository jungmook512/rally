# docker/.env 견본 — cp docker/.env.example docker/.env 후 값 채우기 (docker/.env 는 커밋 금지)
# 네트워크: Wi-Fi Rokey_A (172.24.0.0/22)
ROS_DOMAIN_ID=10
# 물리 PC 2대. 로봇·인식 PC(GPU) = 역할 pc1(네이티브) + pc2(컨테이너), 서버 PC = 역할 pc3
ROBOT_PC_IP=172.24.0.136          # 로봇·인식 PC (기록용, discovery 는 PC3_IP 만 사용)
# PC3_IP = 서버 PC = discovery 서버. 주소는 여기 한 곳에만 둔다 (compose·env_robot_pc.sh 가 읽음)
PC3_IP=172.24.3.122
POSTGRES_PASSWORD=rally
# 대시보드 카메라 칸 — 로봇·인식 PC 의 web_video_server (#140). 비우면 카메라 칸이 꺼진다.
#   값을 바꾸면 dashboard 를 다시 만들어야 반영: docker compose --profile pc3 up -d --force-recreate dashboard
ROBOT_VIDEO_URL=http://172.24.0.136:8080
OPENAI_API_KEY=sk-...
# 음성 장치 (compose voice). 시연은 둘 다 비움 — 소리·마이크 모두 호스트 PipeWire(펄스) 경유 (#183):
#   데스크톱 설정 > 소리 에서 입력 = 맥스틸 C타입 이어셋, 출력 = 방 스피커 (이어셋을 꽂은 뒤 출력이 이어셋으로 바뀌면 다시 방 스피커로)
#   특정 장치를 직접 열 때만 이름 일부나 번호 (hw 장치는 펄스를 우회 — 데스크톱 PC 에서 무음·busy 가능)
VOICE_MIC_DEVICE=
VOICE_SPEAKER_DEVICE=
