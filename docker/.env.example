# docker/.env 견본 — cp docker/.env.example docker/.env 후 값 채우기 (docker/.env 는 커밋 금지)
# 네트워크: Wi-Fi Rokey_A (172.24.0.0/22)
ROS_DOMAIN_ID=10
# PC1·PC2 IP 는 이슈 #5 에서 받는 대로 채운다 (기록용, discovery 는 PC3_IP 만 사용)
PC1_IP=
PC2_IP=
# PC3 = discovery 서버. 바뀌면 ros2_ws/fastdds_client.xml 도 같이 고친다
PC3_IP=172.24.3.122
POSTGRES_PASSWORD=rally
OPENAI_API_KEY=sk-...
